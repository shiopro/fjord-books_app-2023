<div id="<%= dom_id report %>">
  <p>
    <strong>Title:</strong>
    <%= report.title %>
  </p>

  <p>
    <strong>Body:</strong>
    <%= report.body %>
  </p>

  <p>
    <strong>User:</strong>
    <%= report.user.name.present? ? report.user.name : report.user.email %>
  </p>

  <p>
    <strong>Date:</strong>
    <%= report.created_at.to_date %>
  </p>
</div>
